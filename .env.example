# Experience More Bali 2027 - Environment Configuration
# Add your Gemini API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Digital-printing partner for memory gear orders (optional).
# Without a number, the WhatsApp order opens a contact picker.
NEXT_PUBLIC_PRINT_PARTNER_WHATSAPP=
NEXT_PUBLIC_PRINT_PARTNER_EMAIL=

# Public address of the deployed site, so QR codes printed during a local demo
# still open the real site (e.g. https://experience-more-bali.example.com).
NEXT_PUBLIC_SITE_URL=

# KOSSI admin page (/admin): passcode for the verification team (6+ characters).
# Keep it secret; without it the admin page stays locked.
ADMIN_PASSCODE=

# Optional: where partner listings and verification records are saved
# (default: .data/partners.json in the project folder).
# PARTNER_STORE_PATH=
